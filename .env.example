# ---------------------------------------------------------------------------
# Food Planner — environment variables
# Copy to .env for local dev. In Coolify, set these on the Application resource.
# ---------------------------------------------------------------------------

# Postgres connection string. In Coolify use the internal service URL.
DATABASE_URL="postgresql://foodplanner:foodplanner@localhost:5432/foodplanner?schema=public"

# Public base URL of the app (used to build magic links). No trailing slash.
APP_URL="http://localhost:3000"

# Secret used to sign session + magic-link + invite tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-please-generate-a-long-random-string"

# Port the server listens on (Coolify/Docker set this).
PORT=3000

# --- Email delivery -------------------------------------------------------
# Priority: RESEND_API_KEY, then SMTP_*, else links are logged to the console
# (dev only). EMAIL_FROM must be a verified sender/domain in Resend.
EMAIL_FROM="Food Planner <noreply@example.com>"

# Resend (recommended). Leave blank to disable.
RESEND_API_KEY=""

# Generic SMTP fallback. Leave SMTP_HOST blank to disable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# --- Uploads --------------------------------------------------------------
# Directory where recipe image uploads are stored. Mount a persistent volume
# here in Coolify (e.g. /app/uploads).
UPLOAD_DIR="./uploads"
